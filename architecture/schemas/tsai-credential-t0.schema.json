{
  "$comment": "Copyright Amazon.com Inc. or its affiliates. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsai.example.org/schemas/credential-t0.json",
  "title": "TSAI T0 Credential",
  "description": "Trust Signals for Agentic Interactions - Tier 0 (Basic Identity) Credential",
  "type": "object",
  "required": [
    "@context",
    "type",
    "issuer",
    "issuanceDate",
    "expirationDate",
    "credentialSubject"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "https://www.w3.org/ns/credentials/v2"
      },
      "description": "JSON-LD context including W3C VC and TSAI contexts"
    },
    "type": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      },
      "contains": {
        "enum": ["VerifiableCredential", "TSAICredential", "TSAICredentialT0"]
      },
      "description": "Credential types including tier-specific type"
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:",
      "description": "Trust Authority DID (typically did:web)"
    },
    "issuanceDate": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime when credential was issued"
    },
    "expirationDate": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime when credential expires (2-4 hours for T0)"
    },
    "credentialSubject": {
      "type": "object",
      "required": [
        "id",
        "type",
        "tsaiVersion",
        "tsaiTier",
        "operatedBy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:",
          "description": "Agent DID (did:key, did:web, or did:wba)"
        },
        "type": {
          "const": "Agent",
          "description": "Subject type must be Agent"
        },
        "tsaiVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "TSAI protocol version (e.g., 1.0)"
        },
        "tsaiTier": {
          "const": "T0",
          "description": "Trust tier for this credential"
        },
        "operatedBy": {
          "type": "object",
          "required": [
            "id",
            "type",
            "name",
            "jurisdiction",
            "kycLevel"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^did:web:",
              "description": "Operator DID (must be did:web)"
            },
            "type": {
              "const": "Operator",
              "description": "Entity type must be Operator"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Legal name of operator"
            },
            "jurisdiction": {
              "type": "string",
              "pattern": "^[A-Z]{2}$",
              "description": "ISO 3166-1 alpha-2 country code"
            },
            "kycLevel": {
              "type": "string",
              "enum": ["basic", "enhanced", "institutional"],
              "description": "KYC verification level"
            },
            "verifiedDomain": {
              "type": "string",
              "format": "hostname",
              "description": "DNS-verified domain (optional)"
            },
            "domainAge": {
              "type": "integer",
              "minimum": 0,
              "description": "Days since domain registration (optional)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "credentialStatus": {
      "type": "object",
      "description": "Revocation status (optional for T0)",
      "required": [
        "id",
        "type",
        "statusPurpose",
        "statusListIndex",
        "statusListCredential"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "const": "BitstringStatusListEntry"
        },
        "statusPurpose": {
          "const": "revocation"
        },
        "statusListIndex": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "statusListCredential": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$comment": "Copyright Amazon.com Inc. or its affiliates. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsai.example.org/schemas/credential-t1.json",
  "title": "TSAI T1 Credential",
  "description": "Trust Signals for Agentic Interactions - Tier 1 (Identity + Reputation) Credential",
  "type": "object",
  "required": [
    "@context",
    "type",
    "issuer",
    "validFrom",
    "validUntil",
    "credentialSubject"
  ],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "array",
      "contains": {
        "enum": ["VerifiableCredential", "TSAICredential", "TSAICredentialT1"]
      }
    },
    "issuer": {
      "type": "string",
      "pattern": "^did:"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "credentialSubject": {
      "type": "object",
      "required": [
        "id",
        "type",
        "tsaiVersion",
        "tsaiTier",
        "operatedBy",
        "reputation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:"
        },
        "type": {
          "const": "Agent"
        },
        "tsaiVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "tsaiTier": {
          "const": "T1"
        },
        "operatedBy": {
          "type": "object",
          "required": [
            "id",
            "type",
            "name",
            "jurisdiction",
            "kycLevel"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^did:web:"
            },
            "type": {
              "const": "Operator"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "jurisdiction": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "kycLevel": {
              "type": "string",
              "enum": ["basic", "enhanced", "institutional"]
            },
            "verifiedDomain": {
              "type": "string",
              "format": "hostname"
            },
            "domainAge": {
              "type": "integer",
              "minimum": 0
            },
            "certifications": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Industry certifications (ISO27001, SOC2, etc.)"
            },
            "organizationalAffiliation": {
              "type": "string",
              "description": "Parent organization or network membership"
            }
          },
          "additionalProperties": false
        },
        "reputation": {
          "type": "object",
          "required": [
            "interactionCount",
            "successRate"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "TA-specific aggregated trust score (0-100). OPTIONAL. Not comparable across TAs."
            },
            "interactionCount": {
              "type": "integer",
              "minimum": 0,
              "description": "Total interactions evaluated"
            },
            "successRate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Percentage of successful interactions (0-1)"
            },
            "timeInOperation": {
              "type": "integer",
              "minimum": 0,
              "description": "Days agent has been operational"
            },
            "confidenceLevel": {
              "type": "string",
              "enum": ["low", "medium", "high"],
              "description": "Statistical confidence in component signals"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "credentialStatus": {
      "type": "object",
      "description": "Revocation status (recommended for T1)",
      "required": [
        "id",
        "type",
        "statusPurpose",
        "statusListIndex",
        "statusListCredential"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "type": {
          "const": "BitstringStatusListEntry"
        },
        "statusPurpose": {
          "const": "revocation"
        },
        "statusListIndex": {
          "type": "string",
          "pattern": "^\\d+$"
        },
        "statusListCredential": {
          "type": "string",
          "format": "uri"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$comment": "Copyright Amazon.com Inc. or its affiliates. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ta.example/schemas/credential/tsai/1.json",
  "title": "Example TA TSAI Credential",
  "description": "Example derived TSAI credential schema. Composes the canonical TSAI schema and defines the TA-specific rep/risk signal.",
  "allOf": [
    {
      "$ref": "https://tsaiprotocol.org/schemas/tsai-credential/1.json"
    },
    {
      "type": "object",
      "required": ["vct", "aka_vcts", "signals"],
      "properties": {
        "vct": { "const": "https://ta.example/credential/tsai/1" },
        "aka_vcts": {
          "contains": { "const": "https://tsaiprotocol.org/credential/tsai/1" },
          "not": { "contains": { "const": "https://ta.example/credential/tsai/1" } }
        },
        "signals": {
          "contains": {
              "type": "object",
              "required": ["cat", "typ", "level", "model", "asof"],
              "properties": {
                "cat": { "const": "rep" },
                "typ": { "const": "risk" },
                "level": { "type": "string", "enum": ["low", "medium", "high"] },
                "model": { "type": "string", "minLength": 1 },
                "asof": { "type": "integer" }
              },
              "additionalProperties": false
            },
          "items": {
            "oneOf": [
              { "$ref": "https://tsaiprotocol.org/schemas/tsai-credential/1.json#/$defs/registeredSignal" },
              {
              "type": "object",
              "required": ["cat", "typ", "level", "model", "asof"],
              "properties": {
                "cat": { "const": "rep" },
                "typ": { "const": "risk" },
                "level": { "type": "string", "enum": ["low", "medium", "high"] },
                "model": { "type": "string", "minLength": 1 },
                "asof": { "type": "integer" }
              },
              "additionalProperties": false
            }
            ]
          }
        }
      }
    }
  ]
}

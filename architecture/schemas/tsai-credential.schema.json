{
  "$comment": "Copyright Amazon.com Inc. or its affiliates. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsaiprotocol.org/schemas/tsai-credential/1.json",
  "title": "TSAI Credential (SD-JWT VC payload)",
  "description": "The decoded payload of a TSAI credential (SD-JWT VC, draft-ietf-oauth-sd-jwt-vc). The JWS header alg MUST be ES256; that constraint is on the header, not this payload.",
  "type": "object",
  "$defs": {
    "disclosure": {
      "type": "object",
      "required": ["..."],
      "properties": { "...": { "type": "string" } },
      "additionalProperties": false
    },
    "amount": {
      "type": "object",
      "required": ["val", "cur"],
      "properties": {
        "val": { "type": "number" },
        "cur": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "additionalProperties": false
    },
    "identitySignal": {
      "oneOf": [
        {
          "type": "object",
          "required": ["cat", "typ", "val"],
          "properties": {
            "cat": { "const": "idn" },
            "typ": { "const": "org" },
            "val": { "type": "string", "minLength": 1 },
            "asof": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["cat", "typ", "val"],
          "properties": {
            "cat": { "const": "idn" },
            "typ": { "const": "jur" },
            "val": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "asof": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["cat", "typ", "val"],
          "properties": {
            "cat": { "const": "idn" },
            "typ": { "const": "kyc" },
            "val": { "type": "string", "enum": ["basic", "enhanced", "institutional"] },
            "asof": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["cat", "typ", "val", "asof"],
          "properties": {
            "cat": { "const": "idn" },
            "typ": { "const": "dct" },
            "val": { "type": "string", "format": "hostname" },
            "asof": { "type": "integer" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["cat", "typ", "val"],
          "properties": {
            "cat": { "const": "idn" },
            "typ": { "const": "dag" },
            "val": { "type": "string" },
            "asof": { "type": "integer" }
          },
          "additionalProperties": false
        }
      ]
    },
    "reputationSignal": {
      "type": "object",
      "required": ["cat", "typ", "asof", "mtd", "mtd#integrity", "scr", "cnt", "wdw"],
      "properties": {
        "cat": { "const": "rep" },
        "typ": { "type": "string", "enum": ["ecommerce"] },
        "asof": { "type": "integer" },
        "mtd": { "type": "string", "format": "uri", "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[^\\s/?#@:]+)(?::(?:[0-9]{1,4}|[0-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^\\s?#]*)?$" },
        "mtd#integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]+={0,2}$" },
        "scp": { "type": "string", "enum": ["agent", "operator"] },
        "scr": { "type": "number", "minimum": 0, "maximum": 1, "description": "Normalised score; higher values are more favourable under the referenced methodology" },
        "cnt": { "type": "integer", "minimum": 0 },
        "wdw": { "type": "string" }
      },
      "additionalProperties": false
    },
    "complianceSignal": {
      "type": "object",
      "required": ["cat", "typ", "prv", "asof"],
      "properties": {
        "cat": { "const": "cmp" },
        "typ": { "type": "string", "enum": ["iso27001", "soc2", "pci-dss"] },
        "prv": { "type": "string", "pattern": "^did:web:" },
        "asof": { "type": "integer" },
        "vld": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "assuranceSignal": {
      "oneOf": [
        {
          "type": "object",
          "required": ["cat", "typ", "prv", "asof", "cvr"],
          "properties": {
            "cat": { "const": "asr" },
            "typ": { "const": "insurance" },
            "prv": { "type": "string", "pattern": "^did:web:" },
            "asof": { "type": "integer" },
            "cvr": { "$ref": "#/$defs/amount" },
            "basis": { "type": "string", "enum": ["per-incident", "aggregate"] },
            "scope": { "type": "string" },
            "vld": { "type": "integer" },
            "lei": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["cat", "typ", "prv", "asof", "cvr"],
          "properties": {
            "cat": { "const": "asr" },
            "typ": { "const": "collateral" },
            "prv": { "type": "string", "pattern": "^did:web:" },
            "asof": { "type": "integer" },
            "cvr": { "$ref": "#/$defs/amount" },
            "bal": { "type": "number" }
          },
          "additionalProperties": false
        }
      ]
    },
    "registeredSignal": {
      "oneOf": [
        { "$ref": "#/$defs/identitySignal" },
        { "$ref": "#/$defs/reputationSignal" },
        { "$ref": "#/$defs/complianceSignal" },
        { "$ref": "#/$defs/assuranceSignal" },
        { "$ref": "#/$defs/disclosure" }
      ]
    }
  },
  "required": ["iss", "vct", "vct#integrity", "iat", "exp", "sub", "cnf", "signals"],
  "properties": {
    "iss": { "type": "string", "format": "uri", "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[^\\s/?#@:]+)(?::(?:[0-9]{1,4}|[0-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^\\s?#]*)?$", "description": "Trust Authority HTTPS issuer identifier; may include a numeric port and path but no user information, whitespace, query, or fragment (Section 2.8)" },
    "vct": { "type": "string", "format": "uri", "description": "Verifiable credential type and version, resolvable to type metadata" },
    "vct#integrity": { "type": "string", "pattern": "^sha256-[A-Za-z0-9+/]+={0,2}$", "description": "SHA-256 integrity metadata for the vct Type Metadata document, per SD-JWT VC §5" },
    "aka_vcts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri" },
      "description": "Additional credential types; a derived TSAI type MUST include the canonical TSAI vct"
    },
    "iat": { "type": "integer" },
    "exp": { "type": "integer", "description": "30 minutes after iat" },
    "sub": { "type": "string", "format": "uri", "pattern": "^https://[^\\s/?#@:]+(?:/[^\\s?#]*)?$", "description": "Registered persistent agent identifier; no port, and hostname exactly matches a current dct" },
    "cnf": {
      "type": "object",
      "required": ["jwk"],
      "properties": {
        "jwk": {
          "type": "object",
          "required": ["kty", "crv", "x", "y"],
          "properties": {
            "kty": { "const": "EC" },
            "crv": { "const": "P-256" },
            "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
            "y": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
            "alg": { "const": "ES256" },
            "use": { "const": "sig" }
          },
          "not": { "required": ["d"] },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": ["status_list"],
      "properties": {
        "status_list": {
          "type": "object",
          "required": ["idx", "uri"],
          "properties": { "idx": { "type": "integer", "minimum": 0 }, "uri": { "type": "string", "format": "uri", "pattern": "^https://" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "_sd_alg": { "const": "sha-256", "description": "TSAI v1 disclosure digest algorithm" },
    "signals": {
      "type": "array",
      "minItems": 4,
      "description": "Flat trust-signal list; MUST contain the identity floor (org, jur, kyc, dct)",
      "allOf": [
        { "contains": { "type": "object", "properties": { "cat": { "const": "idn" }, "typ": { "const": "org" } }, "required": ["cat", "typ"] } },
        { "contains": { "type": "object", "properties": { "cat": { "const": "idn" }, "typ": { "const": "jur" } }, "required": ["cat", "typ"] } },
        { "contains": { "type": "object", "properties": { "cat": { "const": "idn" }, "typ": { "const": "kyc" } }, "required": ["cat", "typ"] } },
        { "contains": { "type": "object", "properties": { "cat": { "const": "idn" }, "typ": { "const": "dct" } }, "required": ["cat", "typ"] } }
      ]

    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "vct": { "not": { "const": "https://tsaiprotocol.org/credential/tsai/1" } } },
        "required": ["vct"]
      },
      "then": {
        "required": ["aka_vcts"],
        "properties": {
          "aka_vcts": { "contains": { "const": "https://tsaiprotocol.org/credential/tsai/1" } }
        }
      }
    },
    {
      "if": {
        "properties": { "vct": { "const": "https://tsaiprotocol.org/credential/tsai/1" } },
        "required": ["vct"]
      },
      "then": {
        "properties": {
          "aka_vcts": {
            "not": { "contains": { "const": "https://tsaiprotocol.org/credential/tsai/1" } }
          },
          "signals": { "items": { "$ref": "#/$defs/registeredSignal" } }
        }
      }
    }
  ],
  "additionalProperties": true
}

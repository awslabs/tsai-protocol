{
  "$comment": "Copyright Amazon.com Inc. or its affiliates. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsai.example.org/schemas/tsai-credential.json",
  "title": "TSAI Credential (SD-JWT VC payload)",
  "description": "The decoded payload of a TSAI credential (SD-JWT VC, draft-ietf-oauth-sd-jwt-vc). The JWS header alg MUST be one of EdDSA, ES256, ES384, ES512; that constraint is on the header, not this payload.",
  "type": "object",
  "required": ["iss", "vct", "iat", "exp", "cnf", "signals"],
  "properties": {
    "iss": { "type": "string", "format": "uri", "pattern": "^https://", "description": "Trust Authority HTTPS issuer identifier" },
    "vct": { "type": "string", "format": "uri", "description": "Verifiable credential type and version, resolvable to type metadata" },
    "iat": { "type": "integer" },
    "exp": { "type": "integer", "description": "30 minutes after iat" },
    "sub": { "type": "string", "format": "uri", "pattern": "^https://" },
    "cnf": {
      "type": "object",
      "required": ["jwk"],
      "properties": { "jwk": { "type": "object", "required": ["kty"], "additionalProperties": true } },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": ["status_list"],
      "properties": {
        "status_list": {
          "type": "object",
          "required": ["idx", "uri"],
          "properties": { "idx": { "type": "integer", "minimum": 0 }, "uri": { "type": "string", "format": "uri", "pattern": "^https://" } },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "_sd_alg": { "type": "string" },
    "signals": {
      "type": "array",
      "minItems": 4,
      "description": "Flat trust-signal list; MUST contain the identity floor (org, jur, kyc, dct)",
      "allOf": [
        { "contains": { "type": "object", "properties": { "cat": { "const": "idn" }, "typ": { "const": "org" } }, "required": ["cat", "typ"] } },
        { "contains": { "type": "object", "properties": { "cat": { "const": "idn" }, "typ": { "const": "jur" } }, "required": ["cat", "typ"] } },
        { "contains": { "type": "object", "properties": { "cat": { "const": "idn" }, "typ": { "const": "kyc" } }, "required": ["cat", "typ"] } },
        { "contains": { "type": "object", "properties": { "cat": { "const": "idn" }, "typ": { "const": "dct" } }, "required": ["cat", "typ"] } }
      ],
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["cat", "typ"],
            "properties": {
              "cat": { "type": "string", "enum": ["idn", "rep", "cmp", "asr"] },
              "typ": { "type": "string" },
              "prv": { "type": "string", "pattern": "^did:web:" },
              "asof": { "type": "integer" },
              "val": {},
              "band": { "type": "string", "enum": ["insufficient-history", "established", "strong"] },
              "scr": { "type": "number" },
              "cnt": { "type": "integer", "minimum": 0 },
              "wdw": { "type": "string" },
              "vld": { "type": "integer" },
              "lei": { "type": "string" },
              "basis": { "type": "string", "enum": ["per-incident", "aggregate"] },
              "scope": { "type": "string" },
              "cvr": {
                "type": "object",
                "required": ["val", "cur"],
                "properties": { "val": { "type": "number" }, "cur": { "type": "string", "pattern": "^[A-Z]{3}$" } },
                "additionalProperties": false
              },
              "bal": { "type": "number" }
            },
            "allOf": [
              {
                "if": { "properties": { "cat": { "const": "rep" } } },
                "then": { "anyOf": [ { "not": { "anyOf": [ { "required": ["band"] }, { "required": ["scr"] } ] } }, { "required": ["cnt", "wdw"] } ] }
              }
            ],
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": ["..."],
            "properties": { "...": { "type": "string" } },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": true
}

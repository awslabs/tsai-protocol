{
  "$comment": "Copyright Amazon.com Inc. or its affiliates. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsai.example.org/schemas/a2a-agent-card-tsai.json",
  "title": "A2A Agent Card TSAI Security Scheme",
  "description": "TSAI security scheme declaration in an A2A Agent Card",
  "type": "object",
  "required": ["httpAuthSecurityScheme"],
  "properties": {
    "httpAuthSecurityScheme": {
      "type": "object",
      "required": ["scheme"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of TSAI requirements"
        },
        "scheme": {
          "const": "bearer",
          "description": "HTTP authentication scheme (RFC 7235)"
        },
        "bearerFormat": {
          "const": "dc+sd-jwt",
          "description": "Presentation format: a TSAI credential (SD-JWT VC) with a key-binding JWT"
        },
        "trustedAuthorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "Accepted Trust Authority HTTPS issuer identifier"
          },
          "description": "Accepted Trust Authority issuers (TSAI extension)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

{
  "$comment": "Copyright Amazon.com Inc. or its affiliates. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsai.example.org/schemas/a2a-agent-card-tsai.json",
  "title": "A2A Agent Card TSAI Security Scheme",
  "description": "TSAI security scheme declaration in A2A Agent Card using HTTPAuthSecurityScheme",
  "type": "object",
  "required": [
    "httpAuthSecurityScheme"
  ],
  "properties": {
    "httpAuthSecurityScheme": {
      "type": "object",
      "required": [
        "scheme"
      ],
      "properties": {
        "description": {
          "type": "string",
          "description": "Human-readable description of TSAI requirements"
        },
        "scheme": {
          "const": "bearer",
          "description": "HTTP authentication scheme (RFC7235)"
        },
        "bearerFormat": {
          "const": "VP-JWT",
          "description": "Bearer token format (Verifiable Presentation JWT)"
        },
        "minimumTier": {
          "type": "string",
          "enum": ["T0", "T1", "T2", "T3"],
          "description": "Minimum trust tier required (TSAI extension)"
        },
        "trustedAuthorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^did:web:",
            "description": "Trust Authority DID"
          },
          "description": "Accepted TA DIDs (TSAI extension)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

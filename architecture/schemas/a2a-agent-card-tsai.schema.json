{
  "$comment": "Copyright Amazon.com Inc. or its affiliates. SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsaiprotocol.org/schemas/a2a-agent-card-tsai.json",
  "title": "A2A Agent Card TSAI Extension",
  "description": "TSAI declared as an A2A extension. The TSAI-specific fields live in capabilities.extensions (an AgentExtension with a uri and params); the securitySchemes.tsai entry, if present, is a plain httpAuthSecurityScheme carrying only scheme, bearerFormat and description (A2A v1.0).",
  "type": "object",
  "required": ["capabilities"],
  "properties": {
    "capabilities": {
      "type": "object",
      "required": ["extensions"],
      "properties": {
        "extensions": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": ["uri", "params"],
            "properties": {
              "uri": { "const": "https://tsaiprotocol.org/a2a/ext/1" },
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "params": {
                "type": "object",
                "required": ["trustedAuthorities"],
                "properties": {
                  "trustedAuthorities": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "format": "uri", "pattern": "^https://" }
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "securitySchemes": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tsai": {
          "type": "object",
          "properties": {
            "httpAuthSecurityScheme": {
              "type": "object",
              "required": ["scheme"],
              "properties": {
                "scheme": { "const": "bearer" },
                "bearerFormat": { "const": "dc+sd-jwt" },
                "description": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": true
}
